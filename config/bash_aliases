# Convenience aliases for interactive root shells inside the container.
# Copied to /root/.bash_aliases and sourced from /root/.bashrc (see Dockerfile).

# Shell Script to actually wait for Polarion to stop with a 2 min timeout.
polstop() {
  local pidfile="/var/run/polarion/server.pid"
  local timeout=120

  if [ ! -f "$pidfile" ]; then
    echo "Polarion is not running — nothing to stop."
    return 0
  fi

  service polarion stop

  SECONDS=0
  while [ -f "$pidfile" ]; do
    if (( SECONDS >= timeout )); then
      echo "Timed out after ${timeout}s waiting for Polarion to stop." >&2
      return 1
    fi
    echo "Waiting for Polarion to stop."
    sleep 2
  done

  echo "Polarion has fully stopped."
}

# Restart Polarion with a cleared workspace cache, then follow the startup log.
alias plnrestart='polstop && rm -rf /opt/polarion/data/workspace/.config /opt/polarion/data/workspace/.metadata && service polarion start && tail -f /var/log/polarion/polarion.log'

# Follow the most recent main log4j log file.
alias plnmainlog='tail -f "$(ls -t /opt/polarion/data/logs/main/log4j-20*.log 2>/dev/null | head -1)"'
